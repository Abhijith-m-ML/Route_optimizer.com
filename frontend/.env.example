# RouteWise - Environment Configuration Template

# 1. Google Maps Platform Configuration
# Obtain an API key from Google Cloud Console -> APIs & Services -> Credentials
# Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=

# 2. Firebase Authentication Configuration
# Obtain credentials from Firebase Console -> Project Settings -> General -> Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 3. Backend API URL
# For local development: http://localhost:5000
# For production (e.g. Render / Vercel), defaults to: https://vazhikatti-gfuq.onrender.com
VITE_BACKEND_URL=http://localhost:5000
